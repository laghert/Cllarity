    </path>
    <!-- Wewnętrzne światło prawego ucha -->
    <path
        android:fillColor="#66FFFFFF"
        android:pathData="M66,46 C67,36 70,26 69,22 C67,26 63,34 62,46 Z" />

    <!-- 4. Ciało Llumie (Organiczna kropla światła / Duszek) -->
