    <!-- 5. Świetliste serce Llumie (Lumen Core) w brzuszku -->
    <path
        android:pathData="M54,66 C51,62 46,62 44,65 C41,69 45,74 54,80 C63,74 67,69 64,65 C62,62 57,62 54,66 Z">
