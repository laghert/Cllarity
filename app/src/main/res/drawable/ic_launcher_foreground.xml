    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Ambient Glow z tyłu uszu i głowy -->
    <path
        android:fillColor="#33A78BFA"
        android:pathData="M54,58m-34,0a34,34 0 1,0 68,0a34,34 0 1,0 -68,0" />

    <!-- 2. Lewe ucho (Płomień Nadziei z gradientem cyan -> lila) -->
    <path
        android:pathData="M43,50 C41,36 34,22 37,16 C41,20 48,32 49,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="16"
                android:endX="46"
                android:endY="50"
                android:type="linear">
                <item android:offset="0.0" android:color="#67E8F9" />
                <item android:offset="0.5" android:color="#A78BFA" />
                <item android:offset="1.0" android:color="#7C3AED" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Wewnętrzne światło lewego ucha -->
    <path
        android:fillColor="#66FFFFFF"
        android:pathData="M42,46 C41,36 38,26 39,22 C41,26 45,34 46,46 Z" />

    <!-- 3. Prawe ucho (Płomień Nadziei symetryczny) -->
