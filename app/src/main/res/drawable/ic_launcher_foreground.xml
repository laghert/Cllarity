        android:pathData="M54,42 C40,42 32,54 32,68 C32,80 41,88 54,88 C67,88 76,80 76,68 C76,54 68,42 54,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="42"
                android:endX="54"
                android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#C4B5FD" />
