                android:startY="62"
                android:endX="54"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFBEB" />
                <item android:offset="0.6" android:color="#FDE047" />
                <item android:offset="1.0" android:color="#F59E0B" />
            </gradient>
        </aapt:attr>
