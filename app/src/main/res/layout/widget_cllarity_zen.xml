<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header Row: Llumie Avatar + Title & Streak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_llumie_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Llumie"
            android:src="@drawable/ic_cllarity_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Cllarity"
                android:textColor="#F5F4F0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="0 dni dyscypliny"
                android:textColor="#F2CF8B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Level Chip -->
        <TextView
            android:id="@+id/widget_level_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Lvl 1"
            android:textColor="#F5F4F0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#15FFFFFF" />

    <!-- Progress summary & Pledge status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_habits_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 z 3 nawyków dzisiaj"
                android:textColor="#F5F4F0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pledge_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Deklaracja: Czeka na Ciebie"
                android:textColor="#9E9FA6"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quick Action: Otwórz aplikację -->
        <TextView
            android:id="@+id/widget_action_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#20F2CF8B"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Otwórz"
            android:textColor="#F2CF8B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
