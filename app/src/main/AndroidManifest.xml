<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".CllarityApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_cllarity_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_cllarity_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cllarity">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Cllarity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ui.widget.CllarityZenWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cllarity_widget_info" />
        </receiver>
    </application>

</manifest>
